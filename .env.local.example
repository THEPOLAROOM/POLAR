# Copy this file to .env.local and fill in real values from your
# Supabase project (Project Settings → API).
#
# NEXT_PUBLIC_* values are safe to expose to the browser — they only
# grant the "anon"/"publishable" role, which RLS restricts. Never put
# the service-role key in a NEXT_PUBLIC_* variable, and never commit
# .env.local to version control.
#
# NOTE: current Supabase/Vercel projects name this key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (older docs may say ANON_KEY —
# same purpose, this is just the current name).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
